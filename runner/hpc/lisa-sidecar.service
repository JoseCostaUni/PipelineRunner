# The sidecar as a user service of HPC_USER on the login node (SIDECAR_UNIT; ~/.config/systemd/user/).
# Without linger, which Deucalion does not allow, it runs while you have a session on the login node:
# the SSH tunnel from the Kubernetes side is one. 'lisa restore' stops and removes it.
[Unit]
Description=interLink Slurm sidecar ${version} (LISA pipeline runner)
After=network.target

[Service]
Environment=SLURMCONFIGPATH=${sidecar}/SlurmConfig.yaml
Environment=SHARED_FS=true
# With IMAGE_MIRROR=on, Singularity converts each new image inside the job, and Slurm kills it if that
# needs more than the job's memory, which the plugin sets from the pod's limit (--mem in the job script;
# Deucalion enforces it, ConstrainRAMSpace=yes). So every job asks for all of its node's memory: sbatch
# takes SBATCH_MEM_PER_NODE over the script's --mem. The node is the job's anyway (--exclusive), and the
# pods' own limits are then requested, no longer enforced. Without the mirror this line is a comment.
${mirror_memory}
ExecStart=${plugin}
WorkingDirectory=${sidecar}
Restart=always
RestartSec=5
StandardOutput=append:${sidecar}/sidecar.log
StandardError=append:${sidecar}/sidecar.log

[Install]
WantedBy=default.target
