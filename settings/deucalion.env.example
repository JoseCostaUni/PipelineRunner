# Settings of one site: Deucalion's offline compute nodes, from Ulisses. Copy to deucalion.env with
# 'make settings' (git ignores it: it holds the Global Storage keys) and fill in the empty values.
# KEY=VALUE lines, as bash reads them: a value may name an earlier key or an environment variable as $NAME.
# 'lisa sync' copies what the login node needs, without the keys, to HPC_PROJECT_ROOT/runner there.

# --- Deucalion (the HPC side) ---------------------------------------------------------------------
HPC_LOGIN_HOST=ln01.deucalion.macc.fccn.pt
HPC_USER=jcosta.up                                   # your Deucalion account: it runs the sidecar
# A folder of yours, visible from the compute nodes, for the sidecar, its job folders, the tunnel's
# sockets and the images (runner/, sidecar/, sock/, images/). On Deucalion /home/<you>/lisa (/projects
# was full in Nov 2026). Make it private: job folders hold keys and tokens while a pod runs. At most
# 74 characters (the tunnel's socket folder under it must fit in 79).
HPC_PROJECT_ROOT=
SLURM_ACCOUNT=F202500007HPCVLABUPORTOX
SLURM_PARTITION=normal-x86                           # an offline x86 partition; list them with: sinfo -s
SIDECAR_UNIT=lisa-sidecar                            # our user service on the login node
SIDECAR_PORT=4100                                    # its port there (127.0.0.1); 'make check' says if it is free

# --- Ulisses (the Kubernetes side) ----------------------------------------------------------------
SSH_KEY=$HOME/.ssh/id_ed25519                        # private key of HPC_USER here (its .pub uploaded to Deucalion)
INTERLINK_NODE_NAME=interlink-jcosta                 # our virtual node: one per person on a shared cluster
ARGO_NAMESPACE=lisa-jcosta                           # where the workflows run ('make setup' creates it)
TUNNEL_PORT=5100                                     # local end of the SSH tunnel to the sidecar
VK_PORT=5830                                         # the virtual kubelet's port (10250 is the real kubelet's)
# The Kubernetes API address comes from your kubeconfig (KUBECONFIG, default ~/.kube/config); set
# K8S_API_HOST and K8S_API_PORT only to use another. LISA_HOME (default $HOME/lisa-runner) holds
# interLink's binaries, configuration, logs and state.

# --- The Global Storage = Argo's artifact repository ----------------------------------------------
# GS_ENDPOINT=cluster: a MinIO of ours inside the cluster ('make setup' starts it, with GS_ACCESS_KEY and
# GS_SECRET_KEY as its credentials). Or host:port of an S3 endpoint this side reaches. The jobs reach it
# through the tunnel under the Service name GS_SERVICE either way.
GS_ENDPOINT=cluster
GS_BUCKET=argo-artifacts
GS_INSECURE=true                                     # true = plain HTTP
GS_ACCESS_KEY=
GS_SECRET_KEY=                                       # with cluster: choose one, 8 characters or more (openssl rand -hex 16)
GS_SERVICE=global-storage

# --- The tunnel ------------------------------------------------------------------------------------
# Services in the cluster every pod may reach besides the Global Storage and the Kubernetes API, as
# name:port, space separated (names, not IPs; ports 1024 and up), e.g. a message bus:
# EXTRA_FORWARDS="nats.lisa-jcosta.svc.cluster.local:4222"
EXTRA_FORWARDS=

# --- Versions ----------------------------------------------------------------------------------------
IL_VERSION=0.6.3                                     # interLink (here) and its Slurm plugin (login node)
ARGO_VERSION=v3.7.12                                 # installed by 'make setup' only if the cluster has none

# --- Images (compute nodes cannot pull from the internet) -------------------------------------------
# off: every image a pod names is built beforehand on the login node ('make up'), so IMAGES must list
# them all; ARGO_EXEC_IMAGE must be exactly the image Argo puts in every pod ('make check' compares).
ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"
# on (experimental, not yet run on Deucalion): an image mirror in the cluster, reached through the
# tunnel, so a workflow can name any image. Each pod then takes a whole node (--exclusive), and Slurm
# must use proctrack/cgroup ('make check' says). docs/architecture.md, "Any image".
IMAGE_MIRROR=off
