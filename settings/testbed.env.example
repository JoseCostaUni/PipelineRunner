# Settings of the testbed (../testbed): the same flow as on Ulisses, as a user without root on tb-ulisses
# (with a cluster-admin kubeconfig, as on Ulisses) and as 'lisa' on tb-login. 'make testbed-init' copies
# this to testbed.env there; every key is described in deucalion.env.example.

HPC_LOGIN_HOST=192.168.104.3
HPC_USER=lisa
HPC_PROJECT_ROOT=/projects/EEHPC-DEV-2026D02-075/jcosta-trial
SLURM_ACCOUNT=testbed
SLURM_PARTITION=arm
SIDECAR_UNIT=lisa-sidecar
SIDECAR_PORT=4100

SSH_KEY=$HOME/.ssh/id_ed25519
INTERLINK_NODE_NAME=interlink-jcosta
ARGO_NAMESPACE=lisa-jcosta
TUNNEL_PORT=5100
VK_PORT=5830

GS_ENDPOINT=192.168.104.4:9000
GS_BUCKET=argo-artifacts
GS_INSECURE=true
GS_ACCESS_KEY=admin
GS_SECRET_KEY=admin123
GS_SERVICE=global-storage

IL_VERSION=0.6.3                                     # interLink (Ulisses) and its Slurm plugin (login node)
ARGO_VERSION=v3.7.12

ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"
IMAGE_MIRROR=on                                      # the testbed's Slurm uses proctrack/cgroup since 25 Nov 2026, as Deucalion
MIRROR_PRIVATE_REGISTRY=gitlab.esa.int:4567
MIRROR_PRIVATE_USER=
MIRROR_PRIVATE_TOKEN=
