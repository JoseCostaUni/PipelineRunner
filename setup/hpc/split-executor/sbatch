#!/bin/bash
# Split executor for the interLink Slurm sidecar: replacement for sbatch (SlurmConfig SbatchPath).
# Runs on the LOGIN node, called by the sidecar as: sbatch <job folder>/job.slurm
#
# For an Argo pod (init container 'init', containers 'wait' and 'main' in the generated job.sh):
#   1. takes the 'init' and 'wait' lines out of job.sh, so the Slurm job runs 'main' only;
#   2. fixes the input-artifact binds of 'main' (the plugin ignores subPath on emptyDirs);
#   3. submits the job on hold and prints sbatch's output (the sidecar reads the job ID from it);
#   4. starts login.sh in the background: 'init' (downloads inputs to the emptyDirs on the shared
#      FS), then 'scontrol release', then 'wait' (uploads outputs, reports to Kubernetes).
# Any other job is submitted unchanged. Nothing may be printed on stderr unless submission failed:
# the sidecar treats any stderr output as a failed submission.
set -uo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/split.conf"          # REAL_SBATCH, REAL_SQUEUE, REAL_SCANCEL, REAL_SCONTROL
SLURM_FILE="$1"
DIR="$(dirname "$SLURM_FILE")"
JOB="$DIR/job.sh"
LOG="$DIR/split.log"
log() { echo "$(date -Is) $*" >>"$LOG"; }

one_line() { [ "$(grep -c "$1" "$JOB")" = 1 ]; }
if [ ! -f "$JOB" ] || ! one_line '^runInitCtn init ' || ! one_line '^runCtn wait ' || ! one_line '^runCtn main '; then
  exec "$REAL_SBATCH" "$SLURM_FILE"
fi
INIT_LINE="$(grep '^runInitCtn init ' "$JOB")"
WAIT_LINE="$(grep '^runCtn wait ' "$JOB")"
# Both must be complete commands on one line (Argo's init/wait arguments contain no newlines).
if ! bash -n <(printf '%s\n' "$INIT_LINE") 2>/dev/null || ! bash -n <(printf '%s\n' "$WAIT_LINE") 2>/dev/null; then
  log "unexpected init/wait lines, submitting unchanged"
  exec "$REAL_SBATCH" "$SLURM_FILE"
fi
log "Argo pod: init and wait on the login node ($(hostname -s)), main in Slurm"
cp -p "$JOB" "$DIR/job.sh.orig"

# Header of job.sh (functions, workingPath, SANDBOX): everything before the first container line.
HEADER="$(awk '/^(runInitCtn|runCtn) /{exit} {print}' "$JOB")"

# job.sh for Slurm: everything except the init and wait lines.
NEWJOB="$(awk '!/^runInitCtn init / && !/^runCtn wait /' "$JOB")"

# subPath fix: Argo mounts each input artifact into main as input-artifacts/<name> (subPath) at
# the artifact's path; the plugin binds the whole emptyDir there instead. ARGO_TEMPLATE (in the
# containers' env files) maps each path to its artifact name. No JSON parser needed: Argo's encoder
# writes the template's fields in a fixed order (name, inputs, outputs, ...) and each artifact as
# {"name":"...","path":"...",...}, so the input artifacts are the name/path pairs before "outputs".
ENVF=""
for c in init wait main; do [ -f "$DIR/${c}_envfile.properties" ] && { ENVF="$DIR/${c}_envfile.properties"; break; }; done
if [ -n "$ENVF" ]; then
  TPL="$( set +u; set -a; source "$ENVF" >/dev/null 2>&1; printf '%s' "${ARGO_TEMPLATE:-}" )"
  TPL="${TPL%%\"outputs\":*}"
  MAP="$(printf '%s' "$TPL" | grep -o '"name":"[^"]*","path":"[^"]*"' | awk -F'"' '{print $8 "\t" $4}')"
  ED="$DIR/emptyDirs/input-artifacts"
  while IFS=$'\t' read -r apath aname; do
    [ -n "$apath" ] || continue
    # main mounts it at <path>, wait at /mainctrfs<path>
    for dest in "$apath" "/mainctrfs$apath"; do
      from="--bind $ED:$dest:"
      to="--bind $ED/$aname:$dest:"
      if [[ "$NEWJOB" == *"$from"* ]]; then NEWJOB="${NEWJOB//"$from"/"$to"}"; log "subPath fix (main): $dest <- input-artifacts/$aname"; fi
      if [[ "$WAIT_LINE" == *"$from"* ]]; then WAIT_LINE="${WAIT_LINE//"$from"/"$to"}"; log "subPath fix (wait): $dest <- input-artifacts/$aname"; fi
    done
  done <<<"$MAP"
else
  log "no env file found, input-artifact binds not rewritten"
fi
# main executes /var/run/argo/argoexec, which init copied there on the login node. Executing a file
# that another node has just written can fail with "Text file busy" (as for job.sh, below), so the
# compute node makes its own copy first and swaps it in.
NEWJOB="$(printf '%s\n' "$NEWJOB" | awk '
  /^runCtn main / && !done {
    print "# split executor: local copy of argoexec before main starts (ETXTBSY across nodes)"
    print "ae=\"${workingPath}/emptyDirs/var-run-argo/argoexec\""
    print "if [ -f \"$ae\" ]; then cp -p \"$ae\" \"$ae.local\" && mv -f \"$ae.local\" \"$ae\"; fi"
    done=1
  }
  { print }')"
log "argoexec is copied on the compute node before main"

# Replace job.sh atomically (new file, then rename), and make the batch script read it with bash
# instead of executing it: a file just written on the shared FS by another node can still count as
# open for writing, and executing it then fails with "Text file busy" (seen with NFSv4 here).
printf '%s\n' "$NEWJOB" >"$JOB.split-new"
chmod 0774 "$JOB.split-new"
mv -f "$JOB.split-new" "$JOB"
awk -v j="$JOB" '{ if ($0 ~ "^[[:space:]]*" j "[[:space:]]*$") print "/bin/bash " j; else print }' "$SLURM_FILE" >"$SLURM_FILE.split-new"
mv -f "$SLURM_FILE.split-new" "$SLURM_FILE"
grep -q "^/bin/bash $JOB\$" "$SLURM_FILE" && log "batch script runs job.sh with bash" || log "batch script line not changed (has a CommandPrefix?)"

OUT="$("$REAL_SBATCH" --hold "$SLURM_FILE" 2>>"$LOG")"
JID="$(printf '%s' "$OUT" | sed -n 's/.*Submitted batch job \([0-9][0-9]*\).*/\1/p')"
if [ -z "$JID" ]; then
  cp -p "$DIR/job.sh.orig" "$JOB"
  echo "split-executor: held submission failed: $(tail -n 1 "$LOG")" >&2
  exit 1
fi
mkdir -p "$HERE/jobs"
printf '%s\n' "$DIR" >"$HERE/jobs/$JID"

cat >"$DIR/login.sh" <<LOGIN
$HEADER

# ---- split executor (login node) ----
JID="\$1"
split_exit() {
  rc=\$?
  # init failed or release failed: the held job must not stay in the queue
  [ -f "\$workingPath/.split-released" ] || "$REAL_SCANCEL" "\$JID" 2>/dev/null
  printf '%s\n' "\$rc" >"\$workingPath/.split-login-done"
}
trap split_exit EXIT
printf '%s\n' "\$(date -Is --utc) split executor: init and wait on \$(hostname -s), main in Slurm job \$JID"
$INIT_LINE
if ! "$REAL_SCONTROL" release "\$JID"; then
  printf '%s\n' "\$(date -Is --utc) could not release job \$JID" >&2
  exit 1
fi
touch "\$workingPath/.split-released"
printf '%s\n' "\$(date -Is --utc) inputs staged, job \$JID released"
$WAIT_LINE
# Watchdog: Argo's wait only learns that main ended from main's exit code file, written by main's
# emissary. If main never gets that far (the container does not start, the job is cancelled or
# its node fails), wait would poll forever. When the Slurm job is over and main has not reported,
# write main's exit code for it (Slurm's status, never 0), so wait reports the failure.
main_watchdog() {
  ec="\$workingPath/emptyDirs/var-run-argo/ctr/main/exitcode"
  while [ ! -f "\$ec" ]; do
    st="\$("$REAL_SQUEUE" -h -j "\$JID" -o %t 2>/dev/null | head -n 1 | tr -d ' ')"
    case "\$st" in PD|R|CG|CF|S|RQ|RS|RH|SO) sleep 5; continue;; esac
    sleep 15   # the job is over: give the shared FS time to show main's own exit code
    [ -f "\$ec" ] && break
    rc="\$( { tr -dc '0-9' <"\$workingPath/run-main.status"; } 2>/dev/null)"
    { [ -z "\$rc" ] || [ "\$rc" = 0 ]; } && rc=1
    mkdir -p "\$(dirname "\$ec")"
    printf '%s' "\$rc" >"\$ec"
    # main's job.sh never ran to its end: record main's status for the plugin too
    [ -f "\$workingPath/run-main.status" ] || printf '%s\n' "\$rc" >"\$workingPath/run-main.status"
    printf '%s\n' "\$(date -Is --utc) main ended without reporting to Argo (Slurm job \$JID: \${st:-gone}); exit code \$rc written for wait"
    break
  done
}
main_watchdog &
WATCHDOG=\$!
waitCtns
kill "\$WATCHDOG" 2>/dev/null
printf '%s\n' "\$(date -Is --utc) wait finished, highest exit code \$highestExitCode"
LOGIN

# Own systemd user unit, so it survives restarts of the sidecar; plain background job otherwise.
UNIT="split-$(basename "$DIR")"
if command -v systemd-run >/dev/null 2>&1 && \
   systemd-run --user --quiet --collect --unit="$UNIT" -p WorkingDirectory="$DIR" \
     bash -c "exec bash '$DIR/login.sh' '$JID' >>'$DIR/login.out' 2>&1" >>"$LOG" 2>&1; then
  log "job $JID held; login side running as unit $UNIT"
else
  setsid nohup bash "$DIR/login.sh" "$JID" >>"$DIR/login.out" 2>&1 </dev/null &
  log "job $JID held; login side running as pid $! (systemd-run not available)"
fi
printf '%s\n' "$OUT"
