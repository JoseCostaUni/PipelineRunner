#!/bin/bash
# testbed: a small Deucalion-like HPC environment on a Mac (Apple Silicon), built with Lima.
# (The Makefile at the repository root wraps these commands; run 'make' there to see them.)
#
#   ./testbed up            Stage A: create the login and compute node VMs
#   ./testbed check         fidelity checks; report in logs/check-<time>.md
#   ./testbed up-b          Stage B: add 'ulisses' (Kubernetes side + MinIO) using Isabel's scripts
#   ./testbed trial setup   the user who runs the runner as on Ulisses (no root), this repository in its
#                           home, 'make setup' as that user
#   ./testbed trial make T  'make T' of the repository's Makefile as that user (SITE=testbed)
#   ./testbed net dev       compute node WITH internet   (like Deucalion dev-* partitions)
#   ./testbed net normal    compute node WITHOUT internet (like Deucalion normal-* partitions)
#   ./testbed net status    show the current mode
#   ./testbed shell VM      shell as 'lisa' on login|cn, as root on ulisses (--root for root)
#   ./testbed status        show the VMs
#   ./testbed diag          diagnostics of the interLink chain (logs/diag-<time>.txt)
#   ./testbed stop | start  stop or start all VMs (start re-syncs hosts, clocks, network mode)
#   ./testbed clean         remove what tests and checks left in the VMs (jobs, data, caches);
#                           the VMs and their installation stay, logs/ on the Mac stays
#   ./testbed remove        delete the VMs (keeps generated keys and the Slurm build cache)
#   ./testbed destroy       delete the VMs and all generated state
#
# Written for the macOS system bash (3.2): no associative arrays or other bash 4 features.

set -eo pipefail   # no -u: macOS bash 3.2 treats an empty "$@" as unbound

TBDIR="$(cd "$(dirname "$0")" && pwd)"
STATE="$TBDIR/state"
CACHE="$TBDIR/cache"
LOGS="$TBDIR/logs"
GUEST="$TBDIR/guest"
# Isabel Moutinho's repository (FEUP prototype), used unchanged except for CPU architecture names.
# It sits next to José's fork, which holds this folder.
LPR_DIR="${LPR_DIR:-$TBDIR/../../lisa-pipeline-runner}"
# José's fork, this repository: its tests/argo-native go to ulisses.
ZE_DIR="${ZE_DIR:-$TBDIR/..}"

PREFIX="tb"
ALL_VMS="cn login ulisses"
# Rocky Linux 9 for the HPC nodes (Rocky 8 cannot boot on Apple Silicon: its arm64 kernel uses 64K pages).
ROCKY_PINNED="https://dl.rockylinux.org/pub/rocky/9.8/images/aarch64/Rocky-9-GenericCloud-Base-9.8-20260525.0.aarch64.qcow2"
ROCKY_PINNED_DIGEST="sha256:24692a444f1f0b8bb95375c38c8b43f8099a115347623691be2c330b40c8a1fe"
ROCKY_LATEST="https://dl.rockylinux.org/pub/rocky/9/images/aarch64/Rocky-9-GenericCloud.latest.aarch64.qcow2"
# Debian 13 for 'ulisses' (Isabel's Kubernetes scripts are written for Debian).
DEBIAN_PINNED="https://cloud.debian.org/images/cloud/trixie/20261001-2618/debian-13-genericcloud-arm64-20261001-2618.qcow2"
DEBIAN_PINNED_DIGEST="sha512:d8470b8c6c38fead046c794b5800a5a7b96672d5bcf543cc230ceb0c4b8ace05ed341a0c8928045422243fde26b2f1f2f58e99244c65709ffda2e3d4b674dd5a"
DEBIAN_LATEST="https://cloud.debian.org/images/cloud/trixie/daily/latest/debian-13-genericcloud-arm64-daily.qcow2"

TS="$(date +%Y%m%d-%H%M%S)"

# ---------------------------------------------------------------------------- helpers
c_red() { printf '\033[31m%s\033[0m' "$*"; }
c_grn() { printf '\033[32m%s\033[0m' "$*"; }
c_ylw() { printf '\033[33m%s\033[0m' "$*"; }
info() { echo "$(c_grn '==>') $*"; }
warn() { echo "$(c_ylw 'WARN') $*" >&2; }
die() { echo "$(c_red 'ERROR') $*" >&2; exit 1; }

vm() { echo "${PREFIX}-$1"; }

# Run a command in a VM as the default Lima user (no TTY, working dir /).
vsh() { local v; v="$(vm "$1")"; shift; limactl shell --workdir / "$v" "$@" </dev/null; }
# Run a guest script as root / as lisa. Arguments must be simple tokens (no spaces).
vroot() { local n="$1"; shift; vsh "$n" sudo bash "/opt/testbed/guest/$1" "${@:2}"; }
vlisa() { local n="$1"; shift; vsh "$n" sudo -u lisa -H bash "/opt/testbed/guest/$1" "${@:2}"; }

vm_status() { { limactl list --format '{{.Name}} {{.Status}}' 2>/dev/null || true; } | awk -v n="$(vm "$1")" '$1==n {print $2}'; }
# VMs that exist (any state), and VMs that are running.
present_vms() { local n out=""; for n in $ALL_VMS; do [ -n "$(vm_status "$n")" ] && out="$out $n"; done; echo $out; }
running_vms() { local n out=""; for n in $ALL_VMS; do [ "$(vm_status "$n")" = Running ] && out="$out $n"; done; echo $out; }
has_vm() { [ -n "$(vm_status "$1")" ]; }

# Run a step in the background with its output in a log file; sets BG_PID.
BG_PID=""
bg_step() {
  local name="$1"; shift
  ( "$@" ) >"$LOGS/$TS-$name.log" 2>&1 </dev/null &
  BG_PID=$!
}
wait_step() {
  local pid="$1" name="$2"
  if ! wait "$pid"; then
    echo "---- last lines of logs/$TS-$name.log ----" >&2
    tail -n 30 "$LOGS/$TS-$name.log" >&2 || true
    die "step '$name' failed (full log: logs/$TS-$name.log)"
  fi
  info "step '$name' done"
}
# Run a step in the foreground with its output in a log file (shown on failure).
fg_step() {
  local name="$1"; shift
  info "$name ... (log: logs/$TS-$name.log)"
  if ! ( "$@" ) >"$LOGS/$TS-$name.log" 2>&1 </dev/null; then
    echo "---- last lines of logs/$TS-$name.log ----" >&2
    tail -n 30 "$LOGS/$TS-$name.log" >&2 || true
    die "step '$name' failed (full log: logs/$TS-$name.log)"
  fi
  info "step '$name' done"
}

# ---------------------------------------------------------------------------- preflight
preflight() {
  command -v limactl >/dev/null 2>&1 || die "limactl not found. Install Lima: brew install lima"
  local ver major
  ver="$(limactl --version | awk '{print $NF}')"
  major="${ver%%.*}"
  case "$major" in ''|*[!0-9]*) warn "could not parse Lima version '$ver'";; *)
    [ "$major" -ge 1 ] || die "Lima $ver is too old (need >= 1.0). Run: brew upgrade lima";; esac
  [ "$(uname -s)" = "Darwin" ] || warn "this script was written for macOS hosts"
  [ "$(uname -m)" = "arm64" ] || warn "this script assumes an Apple Silicon (arm64) Mac"
  local free_gb
  free_gb="$(df -g "$TBDIR" | awk 'NR==2 {print $4}')"
  case "$free_gb" in ''|*[!0-9]*) ;; *) [ "$free_gb" -ge 20 ] || warn "only ${free_gb} GB free disk; about 20 GB are needed";; esac
  mkdir -p "$STATE" "$CACHE" "$LOGS"
}

# ---------------------------------------------------------------------------- state (keys, VM configs)
gen_state() {
  if [ ! -f "$STATE/munge.key" ]; then
    info "generating the Munge key (shared Slurm authentication)"
    dd if=/dev/urandom bs=1 count=1024 of="$STATE/munge.key" 2>/dev/null
  fi
  if [ ! -f "$STATE/lisa_ed25519" ]; then
    info "generating the SSH key of the HPC user 'lisa'"
    ssh-keygen -q -t ed25519 -N '' -C 'lisa@testbed' -f "$STATE/lisa_ed25519"
  fi
  chmod 600 "$STATE/munge.key" "$STATE/lisa_ed25519"
  write_vm_yaml cn 2 "1536MiB" "12GiB" "$ROCKY_PINNED" "$ROCKY_PINNED_DIGEST" "$ROCKY_LATEST" "Rocky Linux 9"
  write_vm_yaml login 1 "1024MiB" "12GiB" "$ROCKY_PINNED" "$ROCKY_PINNED_DIGEST" "$ROCKY_LATEST" "Rocky Linux 9"
  write_vm_yaml ulisses 2 "4GiB" "25GiB" "$DEBIAN_PINNED" "$DEBIAN_PINNED_DIGEST" "$DEBIAN_LATEST" "Debian 13"
}

write_vm_yaml() {
  local n="$1" cpus="$2" mem="$3" disk="$4" img="$5" digest="$6" latest="$7" os="$8"
  cat >"$STATE/$(vm "$n").yaml" <<EOF
# Generated by testbed. $os, arm64, on Lima's user-v2 network (VM-to-VM traffic allowed).
cpus: $cpus
memory: "$mem"
disk: "$disk"
images:
- location: "$img"
  arch: "aarch64"
  digest: "$digest"
- location: "$latest"
  arch: "aarch64"
# No host folders are mounted: files are copied in with 'limactl copy'.
mounts: []
# No guest ports are forwarded to the Mac: the cluster only talks VM-to-VM.
# (Without this, Lima tries to forward rpcbind's port 111, which macOS already uses.)
portForwards:
- guestIP: "0.0.0.0"
  guestPortRange: [1, 65535]
  proto: any
  ignore: true
- guestPortRange: [1, 65535]
  proto: any
  ignore: true
networks:
- lima: user-v2
containerd:
  system: false
  user: false
EOF
}

# ---------------------------------------------------------------------------- VM lifecycle
start_vm() {
  local n="$1" st
  st="$(vm_status "$n")"
  if [ -z "$st" ]; then
    limactl start --tty=false --name="$(vm "$n")" "$STATE/$(vm "$n").yaml"
  elif [ "$st" != "Running" ]; then
    limactl start --tty=false "$(vm "$n")"
  fi
}

vm_ip() { vsh "$1" ip -4 -o route get 1.1.1.1 | awk '{for (i=1;i<NF;i++) if ($i=="src") print $(i+1)}'; }

# Detect IPs and host names of the running VMs, write state/ips.env and state/hosts.
detect_net() {
  local n ip host up
  : >"$STATE/ips.env"; : >"$STATE/hosts"; : >"$LOGS/$TS-network.log"
  for n in $(running_vms); do
    ip="$(vm_ip "$n")"
    host="$(vsh "$n" hostname -s | tr -d '\r')"
    [ -n "$ip" ] || die "could not detect the IP address of $(vm "$n")"
    up="$(echo "$n" | tr '[:lower:]' '[:upper:]')"
    printf '%s_IP=%s\n%s_HOST=%s\n' "$up" "$ip" "$up" "$host" >>"$STATE/ips.env"
    echo "$ip $host $n" >>"$STATE/hosts"
    { echo "== $n"; vsh "$n" ip -4 -o addr; vsh "$n" ip -4 route; } >>"$LOGS/$TS-network.log" 2>&1 || true
    info "$n = $ip ($host)"
  done
  ip="$(awk -F= '/^CN_IP=/ {print $2}' "$STATE/ips.env")"
  echo "SUBNET=${ip%.*}.0/24" >>"$STATE/ips.env"
}

# Copy guest scripts, state, the Slurm cache (cn) and Isabel's repository (login, ulisses) to /opt/testbed.
sync_vm() {
  local n="$1" v
  v="$(vm "$n")"
  vsh "$n" rm -rf /tmp/tb-sync
  vsh "$n" mkdir -p /tmp/tb-sync
  limactl copy -r "$GUEST" "$STATE" "$v:/tmp/tb-sync/"
  if [ "$n" = cn ] && [ -d "$CACHE/rpms" ]; then
    limactl copy -r "$CACHE/rpms" "$v:/tmp/tb-sync/"
  fi
  if [ "$n" != cn ] && [ -d "$LPR_DIR/setup" ]; then
    vsh "$n" mkdir -p /tmp/tb-sync/lpr
    limactl copy -r "$LPR_DIR/setup" "$LPR_DIR/tests" "$v:/tmp/tb-sync/lpr/"
  fi
  if [ "$n" = ulisses ] && [ -d "$ZE_DIR/tests/argo-native" ]; then
    vsh "$n" mkdir -p /tmp/tb-sync/ze
    limactl copy -r "$ZE_DIR/tests/argo-native" "$v:/tmp/tb-sync/ze/"
  fi
  vsh "$n" sudo rm -rf /opt/testbed
  vsh "$n" sudo cp -r /tmp/tb-sync /opt/testbed
  # Scripts must be readable by lisa (probes); the keys in state/ by root only.
  vsh "$n" sudo chmod -R a+rX,go-w /opt/testbed
  vsh "$n" sudo chmod -R go-rwx /opt/testbed/state
  vsh "$n" rm -rf /tmp/tb-sync
}

refresh() {
  detect_net
  local n
  for n in $(running_vms); do sync_vm "$n"; done
  for n in $(running_vms); do vroot "$n" refresh.sh; done
}

# Only one of check / clean at a time: each switches the compute node's network mode, so
# running two together silently mixes their results.
take_lock() {
  local f="$STATE/.lock" p
  if [ -f "$f" ]; then
    p="$(cat "$f" 2>/dev/null)"
    if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
      die "another testbed command is running (pid $p: check or clean). Wait for it, or stop it first."
    fi
  fi
  echo $$ >"$f"
  trap 'rm -f "$STATE/.lock"' EXIT
}

require_running() {
  local n
  for n in "$@"; do [ "$(vm_status "$n")" = "Running" ] || die "VM $(vm "$n") is not running (./testbed start, or ./testbed up / up-b)"; done
}

# ---------------------------------------------------------------------------- commands
cmd_up() {
  preflight
  gen_state
  info "starting the VMs (first run downloads Rocky Linux 9, about 600 MB)"
  local p1 p2
  # Sequential on purpose: the second VM reuses the image the first one downloaded.
  start_vm cn
  start_vm login

  detect_net
  sync_vm cn
  sync_vm login

  info "provisioning (the compute node builds Slurm 23.11.4 the first time)"
  bg_step provision-cn sh_cn; p1=$BG_PID
  bg_step provision-login-base vroot login common.sh login; p2=$BG_PID
  wait_step "$p2" provision-login-base
  wait_step "$p1" provision-cn

  if [ ! -d "$CACHE/rpms" ]; then
    info "saving the Slurm packages to cache/ for faster rebuilds"
    limactl copy -r "$(vm cn):/opt/rpms" "$CACHE/" || warn "could not cache the Slurm packages"
  fi

  fg_step provision-login vroot login login.sh

  info "switching the compute node to 'normal' (no internet)"
  vroot cn netmode.sh normal
  info "Stage A is up. Next: ./testbed check"
}
sh_cn() { vroot cn common.sh cn && vroot cn cn.sh; }

cmd_up_b() {
  preflight
  [ -d "$LPR_DIR/setup/kubernetes" ] || die "Isabel's repository not found at $LPR_DIR (set LPR_DIR=...)"
  has_vm cn && has_vm login || die "Stage A is not built yet. Run ./testbed up first"
  gen_state
  start_vm cn
  start_vm login
  info "starting 'ulisses' (first run downloads Debian 13, about 400 MB)"
  start_vm ulisses
  refresh

  fg_step provision-ulisses vroot ulisses ulisses.sh
  fg_step provision-login-hpc vroot login login-b.sh

  info "waiting for the virtual node 'interlink-node' to become Ready"
  local i
  for i in $(seq 1 60); do
    if vroot ulisses probe.sh k8s-node >/dev/null 2>&1; then break; fi
    sleep 5
  done
  if ! vroot ulisses probe.sh k8s-node; then
    cmd_diag
    die "interlink-node is not Ready. Diagnostics above (and in logs/diag-$TS.txt)"
  fi
  vroot cn netmode.sh normal >/dev/null
  info "Stage B is up. Next: ./testbed check, then 'make init' in the repository root"
}

cmd_diag() {
  require_running login ulisses
  sync_vm login
  sync_vm ulisses
  { vroot ulisses diag.sh; vroot login diag.sh; } 2>&1 | tee "$LOGS/diag-$TS.txt"
  info "diagnostics saved to logs/diag-$TS.txt"
}

cmd_start() {
  preflight
  local n
  for n in $(present_vms); do start_vm "$n"; done
  refresh
  info "testbed started (compute node network mode: $(vroot cn netmode.sh get))"
}

cmd_stop() {
  local n
  for n in $(running_vms); do limactl stop "$(vm "$n")"; done
  info "VMs stopped"
}

cmd_down() {
  local n
  for n in $(present_vms); do limactl delete -f "$(vm "$n")"; done
  info "VMs deleted (state/, cache/ and logs/ kept; 'make init' at the repository root rebuilds them)"
}

# Back to a just-provisioned state without rebuilding: no workflows, Jobs, Slurm jobs, job
# folders, pre-pulled images or Singularity caches in the VMs; compute node 'normal'.

cmd_clean() {
  preflight
  take_lock
  local n
  [ -n "$(running_vms)" ] || die "no testbed VM is running (make start)"
  for n in $(running_vms); do sync_vm "$n"; done
  # ulisses first: removing the pods makes interLink cancel their Slurm jobs.
  for n in ulisses login cn; do
    [ "$(vm_status "$n")" = Running ] || continue
    vroot "$n" clean.sh all
  done
  for n in $ALL_VMS; do
    if has_vm "$n" && [ "$(vm_status "$n")" != Running ]; then warn "$(vm "$n") is not running, so it was not cleaned"; fi
  done
  info "VMs cleaned (logs/ on the Mac kept)"
}

cmd_destroy() {
  cmd_down
  rm -rf "$STATE"
  info "state/ removed (cache/ kept; delete it by hand to rebuild Slurm)"
}

cmd_status() {
  { limactl list 2>/dev/null || true; } | awk -v p="${PREFIX}-" 'NR==1 || index($1,p)==1'
  if [ "$(vm_status cn)" = "Running" ]; then
    echo
    echo "compute node network mode: $(vroot cn netmode.sh get)"
  fi
  if [ "$(vm_status ulisses)" = "Running" ]; then
    echo "virtual node interlink-node: $(vroot ulisses probe.sh k8s-node 2>/dev/null || echo 'not Ready')"
  fi
}

cmd_net() {
  local mode="${1:-status}"
  case "$mode" in
    dev|normal) vroot cn netmode.sh "$mode" >/dev/null; info "compute node is now '$mode'";;
    status) vroot cn netmode.sh status; [ "$(vm_status login)" = Running ] && vroot login loginnet.sh status;;
    *) die "usage: ./testbed net dev|normal|status";;
  esac
}

cmd_shell() {
  local n="${1:-login}" root="${2:-}"
  case "$n" in cn|login|ulisses) ;; *) die "usage: ./testbed shell login|cn|ulisses [--root]";; esac
  if [ "$root" = "--root" ] || [ "$n" = ulisses ]; then
    limactl shell --workdir / "$(vm "$n")" sudo -i
  else
    limactl shell --workdir / "$(vm "$n")" sudo -iu lisa
  fi
}

# ---------------------------------------------------------------------------- checks
RESULTS=""
NPASS=0
NFAIL=0
record() { # id, PASS/FAIL, description, detail
  local mark
  if [ "$2" = PASS ]; then NPASS=$((NPASS + 1)); mark="$(c_grn PASS)"; else NFAIL=$((NFAIL + 1)); mark="$(c_red FAIL)"; fi
  printf '%-4s %s  %s\n' "$1" "$mark" "$3"
  [ -z "${4:-}" ] || printf '           %s\n' "$4"
  RESULTS="$RESULTS| $1 | $2 | $3 | ${4:-} |
"
}
expect_ok() { # id, description, command...
  local id="$1" d="$2" out; shift 2
  if out="$("$@" 2>&1)"; then record "$id" PASS "$d" "$(echo "$out" | tail -n 1)"
  else record "$id" FAIL "$d" "$(echo "$out" | tail -n 1)"; fi
}
expect_fail() {
  local id="$1" d="$2" out; shift 2
  if out="$("$@" 2>&1)"; then record "$id" FAIL "$d" "unexpectedly succeeded: $(echo "$out" | tail -n 1)"
  else record "$id" PASS "$d" "$(echo "$out" | tail -n 1)"; fi
}

# Succeeds if the login node can open SSH (22) or Argo's web UI (32746) on ulisses.
login_reaches_ulisses() { vroot login probe.sh tcp "$1" 22 || vroot login probe.sh tcp "$1" 32746; }

cmd_check() {
  preflight
  take_lock
  require_running cn login
  local n
  for n in $(running_vms); do sync_vm "$n"; done
  local mode0 stage_b=""
  [ "$(vm_status ulisses)" = Running ] && stage_b=1
  mode0="$(vroot cn netmode.sh get)"
  echo "Fidelity checks ($(date)). Compute node mode at start: $mode0"
  echo

  # --- login node
  expect_ok   L1 "login node reaches the internet" vroot login probe.sh internet
  expect_fail L2 "user lisa has no sudo on the login node" vlisa login probe.sh sudo
  expect_ok   L3 "ssh -L (local forwarding) is allowed for lisa" vlisa login probe.sh ssh-local
  expect_fail L4 "ssh -R (remote forwarding) is refused for lisa" vlisa login probe.sh ssh-remote

  # --- compute node without internet
  vroot cn netmode.sh normal >/dev/null
  expect_fail N1 "[normal] compute node cannot reach the internet" vroot cn probe.sh internet
  expect_fail N2 "[normal] compute node cannot resolve public names" vroot cn probe.sh dns
  expect_ok   N3 "[normal] compute node reaches the login node" vroot cn probe.sh reach login

  # --- shared file system
  local tok
  tok="tok-$TS"
  vroot cn probe.sh prepdirs >/dev/null
  vlisa cn probe.sh write /projects/.testbed/lisa/from-cn "$tok" >/dev/null
  expect_ok   F1 "file written on cn is visible on login" vlisa login probe.sh readeq /projects/.testbed/lisa/from-cn "$tok"
  vlisa login probe.sh write /home/lisa/.tb-from-login "$tok" >/dev/null
  expect_ok   F2 "home written on login is visible on cn" vlisa cn probe.sh readeq /home/lisa/.tb-from-login "$tok"

  # --- inotify across nodes (expected: no event, as on a real cluster)
  local tmp pid r
  tmp="$(mktemp)"
  vroot login probe.sh rmdir-contents /projects/.testbed/ino >/dev/null
  ( vroot login probe.sh inotify /projects/.testbed/ino 12 >"$tmp" 2>&1 || true ) &
  pid=$!
  sleep 4
  vroot cn probe.sh touch /projects/.testbed/ino/created-on-cn >/dev/null
  wait "$pid" || true
  r="$(tail -n 1 "$tmp")"
  if [ "$r" = "NOEVENT" ]; then record I1 PASS "file created on cn does NOT trigger inotify on login" "$r"
  else record I1 FAIL "file created on cn does NOT trigger inotify on login" "$r"; fi
  expect_ok   I2 "...but the file is visible on login (shared FS works)" vroot login probe.sh exists /projects/.testbed/ino/created-on-cn
  ( vroot login probe.sh inotify /projects/.testbed/ino 12 >"$tmp" 2>&1 || true ) &
  pid=$!
  sleep 4
  vroot login probe.sh touch /projects/.testbed/ino/created-on-login >/dev/null
  wait "$pid" || true
  r="$(tail -n 1 "$tmp")"
  if [ "$r" = "EVENT" ]; then record I3 PASS "control: file created on login DOES trigger inotify on login" "$r"
  else record I3 FAIL "control: file created on login DOES trigger inotify on login" "$r"; fi
  rm -f "$tmp"

  # --- Slurm and Singularity, compute node without internet
  expect_ok   S1 "Slurm: partition up and compute node available" vlisa login probe.sh sinfo
  expect_ok   S2 "Slurm: sbatch from login runs on the compute node" vlisa login probe.sh job-hostname
  expect_ok   S3 "Singularity: image pulled on the login node" vlisa login probe.sh pull-sif
  expect_ok   S4 "[normal] job runs a pre-pulled image from the shared FS" vlisa login probe.sh job-sif
  expect_fail S5 "[normal] job cannot pull docker:// images on the compute node" vlisa login probe.sh job-docker

  # --- Stage B: the Kubernetes side and the Global Storage are outside the cluster network
  if [ -n "$stage_b" ]; then
    local uip
    uip="$(awk -F= '/^ULISSES_IP=/ {print $2}' "$STATE/ips.env")"
    expect_ok   U1 "login node reaches the Global Storage (MinIO: on the ulisses VM here, a separate host on Deucalion)" vroot login probe.sh http "http://$uip:9000/minio/health/live"
    expect_fail U2 "[normal] compute node cannot reach MinIO" vroot cn probe.sh http "http://$uip:9000/minio/health/live"
    expect_fail U3 "[normal] compute node cannot reach the Kubernetes API" vroot cn probe.sh http "https://$uip:6443/version"
    expect_ok   U4 "virtual node interlink-node is Ready" vroot ulisses probe.sh k8s-node
    # The login node cannot call the Kubernetes side; the Kubernetes side can SSH into it.
    local lip
    lip="$(awk -F= '/^LOGIN_IP=/ {print $2}' "$STATE/ips.env")"
    vroot login loginnet.sh apply >/dev/null
    expect_fail U5 "login node cannot reach the Kubernetes API on ulisses" vroot login probe.sh http "https://$uip:6443/version"
    expect_fail U6 "login node cannot open SSH or Argo's web UI on ulisses" login_reaches_ulisses "$uip"
    expect_ok   U7 "ulisses can SSH into the login node (as interLink's tunnel does)" vroot ulisses probe.sh ssh-lisa "$lip" /root/.ssh/id_ed25519
  fi

  # --- compute node with internet
  vroot cn netmode.sh dev >/dev/null
  expect_ok   D1 "[dev] compute node reaches the internet" vroot cn probe.sh internet
  expect_ok   D2 "[dev] job pulls and runs a docker:// image on the compute node" vlisa login probe.sh job-docker
  if [ -n "$stage_b" ]; then
    expect_ok D3 "[dev] compute node reaches MinIO" vroot cn probe.sh http "http://$uip:9000/minio/health/live"
  fi

  # --- clocks (Munge needs them in sync)
  local t1 t2 dt
  t1="$(vroot login probe.sh epoch)"; t2="$(vroot cn probe.sh epoch)"
  dt=$((t1 - t2)); [ "$dt" -lt 0 ] && dt=$((-dt))
  if [ "$dt" -le 2 ]; then record C1 PASS "clocks of login and cn agree" "difference ${dt}s"
  else record C1 FAIL "clocks of login and cn agree" "difference ${dt}s"; fi

  vroot cn netmode.sh "$mode0" >/dev/null
  echo
  echo "$NPASS passed, $NFAIL failed. Compute node restored to '$mode0'."
  {
    echo "# Testbed fidelity checks ($TS)"
    echo
    echo "| ID | Result | Check | Detail |"
    echo "|---|---|---|---|"
    printf '%s' "$RESULTS"
    echo
    echo "$NPASS passed, $NFAIL failed."
  } >"$LOGS/check-$TS.md"
  info "report: logs/check-$TS.md"
  [ "$NFAIL" -eq 0 ]
}

# ---------------------------------------------------------------------------- trial
# The runner is set up and tested here as on Ulisses: as a user without root on ulisses (a cluster-admin
# kubeconfig through a ServiceAccount token, guest/trial-user.sh) and as 'lisa' on the login node, with
# settings/testbed.env.example as settings.
TRIAL_USER="${TRIAL_USER:-jcosta}"
trial_make() { # targets of the repository's Makefile as the trial user, with SITE=testbed
  local s
  s="$(mktemp)"
  { printf 'cd ~/PipelineRunner && make'; printf ' %q' "$@"; printf ' SITE=testbed\n'; } >"$s"
  limactl copy "$s" "$(vm ulisses):/tmp/trial-make.sh"; rm -f "$s"
  vsh ulisses chmod 644 /tmp/trial-make.sh   # mktemp's 600 would keep the trial user out
  limactl shell --workdir / "$(vm ulisses)" sudo -u "$TRIAL_USER" -i bash /tmp/trial-make.sh
}
cmd_trial() {
  case "${1:-}" in
    setup)
      local key t
      limactl copy "$GUEST/trial-user.sh" "$(vm ulisses):/tmp/trial-user.sh"
      key="$(vsh ulisses sudo bash /tmp/trial-user.sh "$TRIAL_USER" | tail -n 1)"
      [ -n "$key" ] || die "could not create the trial user on ulisses"
      vsh login sudo -u lisa bash -c "grep -qxF '$key' ~/.ssh/authorized_keys 2>/dev/null || echo '$key' >>~/.ssh/authorized_keys"
      # This repository, as committed or not, without what only lives on the Mac: settings files
      # (deucalion.env holds real keys), results, the Mac's Python environment, the testbed's own
      # state, git.
      t="$(mktemp)"
      ( cd "$ZE_DIR" && COPYFILE_DISABLE=1 tar czf "$t" --exclude ./.git --exclude ./results --exclude ./.venv \
          --exclude '*.env' --exclude .DS_Store --exclude ./testbed/cache --exclude ./testbed/state \
          --exclude ./testbed/logs --exclude './*.pdf' . )
      limactl copy "$t" "$(vm ulisses):/tmp/trial-repo.tgz"; rm -f "$t"
      vsh ulisses sudo bash -c "R=/home/$TRIAL_USER/PipelineRunner; mkdir -p \$R && tar xzf /tmp/trial-repo.tgz -C \$R 2>/dev/null; \
        [ -f \$R/settings/testbed.env ] || cp \$R/settings/testbed.env.example \$R/settings/testbed.env; \
        chmod 600 \$R/settings/testbed.env; chown -R $TRIAL_USER: \$R; rm -f /tmp/trial-repo.tgz"
      trial_make setup
      ;;
    make) shift; trial_make "$@" ;;
    *) die "usage: $0 trial setup | trial make <targets of the repository's Makefile>" ;;
  esac
}

# ---------------------------------------------------------------------------- main
usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  up) cmd_up "$@";;
  up-b) cmd_up_b "$@";;
  check) cmd_check "$@";;
  diag) cmd_diag "$@";;
  trial) cmd_trial "$@";;
  net) cmd_net "$@";;
  shell) cmd_shell "$@";;
  status) cmd_status "$@";;
  start) cmd_start "$@";;
  stop) cmd_stop "$@";;
  clean) cmd_clean "$@";;
  remove|down) cmd_down "$@";;
  destroy) cmd_destroy "$@";;
  help|-h|--help) usage;;
  *) usage; exit 1;;
esac
