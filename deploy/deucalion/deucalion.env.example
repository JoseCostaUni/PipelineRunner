# Settings for the Deucalion trial of the split executor.
# Copy to deucalion.env (ignored by git: it holds the Global Storage keys) and fill in.
# The same file is read by hpc-side.sh (Deucalion login node) and k8s-side.sh (Ulisses).
# Defaults are the values of Isabel Moutinho's deployment (lisa-pipeline-runner/setup/*/.env.example).

# --- Deucalion (HPC side) ----------------------------------------------------------------------
HPC_LOGIN_HOST=ln01.deucalion.macc.fccn.pt          # login node where Isabel's interlink-sidecar runs
HPC_USER=isabelmoutinho                              # account that runs the sidecar (SIDECAR_SSH_USER)
HPC_PROJECT_ROOT=/projects/EEHPC-DEV-2026D02-075/lisa-pipeline-runner
SLURM_ACCOUNT=eehpc-dev-2026d02-075x
SLURM_PARTITION=normal-x86                           # an air-gapped partition; confirm the name with: sinfo -s

# --- Kubernetes side (Ulisses) -----------------------------------------------------------------
K8S_API_HOST=10.227.208.123                          # Ulisses (MACHINE_HOST in her .env)
K8S_API_PORT=6443
SSH_KEY=/root/.ssh/id_ed25519                        # key of her tunnel (SIDECAR_SSH_KEY_PATH)
INTERLINK_INSTALL_DIR=/opt/interlink
INTERLINK_NODE_NAME=interlink-node
ARGO_NAMESPACE=default                               # namespace the test workflows run in

# --- Global Storage = Argo's artifact repository ------------------------------------------------
# init and wait reach it from the login node, so it must be reachable from there (her MinIO VM).
GS_ENDPOINT=68.221.216.246:9000
GS_BUCKET=argo-artifacts
GS_INSECURE=true                                     # true = plain http
GS_ACCESS_KEY=
GS_SECRET_KEY=

# --- API relay (only if the login node cannot reach K8S_API_HOST:K8S_API_PORT) -----------------
# Both ports listen on 127.0.0.1 of the login node. Pick free ones (shared node): ss -ltn
RELAY_API_PORT=16443
RELAY_CTL_PORT=16444

# --- Images (compute nodes cannot pull) --------------------------------------------------------
# Every image a pod names must be pulled beforehand. ARGO_EXEC_IMAGE must be exactly the image the
# controller puts in the pods: print it on Ulisses with  ./k8s-side.sh executor-image
ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"                                 # images of tests/argo-native (space separated)
