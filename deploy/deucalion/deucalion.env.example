# Settings for running plain Argo workflows on Deucalion through interLink 0.6.3 and its reverse tunnel.
# Copy to deucalion.env ('make env'; ignored by git: it holds the Global Storage keys) and fill in the
# empty values. k8s-side.sh reads it on Ulisses; 'make sync' copies it, without the keys, to the login
# node for hpc-side.sh. Everything runs as your own accounts: on Ulisses with a cluster-admin kubeconfig
# and no sudo, on Deucalion as HPC_USER.

# --- Deucalion (HPC side) ----------------------------------------------------------------------
HPC_LOGIN_HOST=ln01.deucalion.macc.fccn.pt
HPC_USER=jcosta.up                                   # your Deucalion account: it runs the sidecar
# A folder of yours for the sidecar, job folders, images and the subPath fix, visible from the compute
# nodes. On Deucalion /home/<you>/lisa (/projects was full in Nov 2026). At most 59 characters (the
# tunnel's socket folder under it must fit in 79).
HPC_PROJECT_ROOT=
HPC_REPO_DIR=$HPC_PROJECT_ROOT/lisa-pipeline-runner_ze   # the scripts on the login node ('make sync')
SLURM_ACCOUNT=F202500007HPCVLABUPORTOX
SLURM_PARTITION=normal-x86                           # an air-gapped x86 partition; list them with: sinfo -s
SIDECAR_UNIT=lisa-sidecar                            # our user service on the login node
SIDECAR_PORT=4100                                    # its port on the login node (127.0.0.1); 'make check' says if it is free

# --- Ulisses (Kubernetes side) ------------------------------------------------------------------
SSH_KEY=$HOME/.ssh/id_ed25519                        # private key of HPC_USER on Ulisses (its .pub uploaded to Deucalion)
INTERLINK_NODE_NAME=interlink-jcosta                 # our virtual node: one per person on a shared cluster
ARGO_NAMESPACE=lisa-jcosta                           # where the test workflows run ('make setup' creates it)
TUNNEL_PORT=5100                                     # local end of the ssh tunnel to the sidecar
VK_PORT=5830                                         # the virtual kubelet's port (10250 is the real kubelet's)
# The Kubernetes API address comes from your kubeconfig; set K8S_API_HOST and K8S_API_PORT only to use
# another one. TRIAL_HOME (default $HOME/lisa-trial) holds interLink's binaries, configs, logs and state.

# --- Global Storage = Argo's artifact repository ------------------------------------------------
# Ulisses reaches it; the jobs reach it through the tunnel under the Service name GS_SERVICE.
# GS_ENDPOINT=cluster: a MinIO of ours inside the cluster ('make setup' or 'make minio' starts it, with
# GS_ACCESS_KEY/GS_SECRET_KEY as its credentials).
GS_ENDPOINT=cluster                                  # or host:port of an S3 endpoint (Isabel's MinIO: 68.221.216.246:9000, down in Nov 2026)
GS_BUCKET=argo-artifacts
GS_INSECURE=true                                     # true = plain http
GS_ACCESS_KEY=
GS_SECRET_KEY=                                       # with cluster: choose one, at least 8 characters (openssl rand -hex 16)
GS_SERVICE=global-storage                            # Service name of the Global Storage in ARGO_NAMESPACE

# --- The tunnel ----------------------------------------------------------------------------------
# Services inside the cluster every pod may reach besides the Global Storage and the API, as
# name:port, space separated (names, not IPs; ports 1024 and up), e.g. a message bus:
# EXTRA_FORWARDS="nats.lisa-jcosta.svc.cluster.local:4222"
EXTRA_FORWARDS=

# --- Versions ------------------------------------------------------------------------------------
IL_VERSION=0.6.3                                     # interLink (Ulisses) and its Slurm plugin (login node)
ARGO_VERSION=v3.7.12                                 # installed by 'make setup' only if the cluster has no Argo

# --- Images (compute nodes cannot pull) --------------------------------------------------------
# Every image a pod names must be pulled beforehand. ARGO_EXEC_IMAGE must be exactly the image the
# controller puts in the pods ('make check' compares them).
ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"                                 # images of tests/argo-native (space separated)
