# The same settings for the testbed (../../testbed): rehearse the trial as a user without root on
# tb-ulisses (with a cluster-admin kubeconfig, as on Ulisses) and as 'lisa' on tb-login.
# Copy to testbed.env and run the Makefile with ENV_FILE=testbed.env.

HPC_LOGIN_HOST=192.168.104.3
HPC_USER=lisa
HPC_PROJECT_ROOT=/projects/EEHPC-DEV-2026D02-075/jcosta-trial
HPC_REPO_DIR=$HPC_PROJECT_ROOT/lisa-pipeline-runner_ze
SLURM_ACCOUNT=testbed
SLURM_PARTITION=arm
SIDECAR_UNIT=lisa-sidecar
SIDECAR_PORT=4100

SSH_KEY=$HOME/.ssh/id_ed25519
INTERLINK_NODE_NAME=interlink-jcosta
ARGO_NAMESPACE=lisa-jcosta
TUNNEL_PORT=5100
VK_PORT=5830

GS_ENDPOINT=192.168.104.4:9000
GS_BUCKET=argo-artifacts
GS_INSECURE=true
GS_ACCESS_KEY=admin
GS_SECRET_KEY=admin123
GS_SERVICE=global-storage

SPLIT_API=relay
RELAY_API_PORT=17443
RELAY_CTL_PORT=17444

SPLIT_IL_VERSION=0.6.1
REVERSE_IL_VERSION=0.6.3
ARGO_VERSION=v3.7.12

ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"
