# Settings for the rehearsal of the Deucalion trial on the local testbed (../../../testbed).
# Same keys as deucalion.env.example; the values are the testbed's (state/ips.env, Isabel's setup
# as the testbed installs it). Use it with:  SPLIT_ENV=$PWD/testbed.env ./hpc-side.sh ...

# --- HPC side: the login VM --------------------------------------------------------------------
HPC_LOGIN_HOST=192.168.104.3
HPC_USER=lisa
HPC_PROJECT_ROOT=/projects/EEHPC-DEV-2026D02-075/lisa-pipeline-runner
SLURM_ACCOUNT=testbed
SLURM_PARTITION=arm

# --- Kubernetes side: the ulisses VM -----------------------------------------------------------
K8S_API_HOST=192.168.104.4
K8S_API_PORT=6443
SSH_KEY=/root/.ssh/id_ed25519
INTERLINK_INSTALL_DIR=/opt/interlink
INTERLINK_NODE_NAME=interlink-node
ARGO_NAMESPACE=default

# --- Global Storage: MinIO on ulisses (Isabel's default keys) ----------------------------------
GS_ENDPOINT=192.168.104.4:9000
GS_BUCKET=argo-artifacts
GS_INSECURE=true
GS_ACCESS_KEY=admin
GS_SECRET_KEY=admin123

# --- API relay ---------------------------------------------------------------------------------
RELAY_API_PORT=16443
RELAY_CTL_PORT=16444

# --- Images ------------------------------------------------------------------------------------
ARGO_EXEC_IMAGE=quay.io/argoproj/argoexec:v3.7.12
IMAGES="alpine:3.20"
